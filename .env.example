# Copia este fichero a .env y rellena lo que necesites. .env está en .gitignore.

# Token de Hugging Face (solo hace falta para modelos con acceso restringido)
HF_TOKEN=

# Dónde guardar los modelos descargados. En la DGX conviene apuntar a un disco compartido.
HF_HOME=./hf_cache

# Qué GPUs ve el proceso. En la DGX NO lo toquéis: SLURM lo fija a la partición que os asigna.
# Solo tiene sentido en una máquina propia con varias GPUs, por ejemplo "0" o "2,3".
# CUDA_VISIBLE_DEVICES=0

# Puerto de la API
ARCA_API_PORT=8000

# Identificación del equipo (sale en /health)
ARCA_TEAM=Almudena, Gloria y Victoria
ARCA_DOMAIN=Clasificación de riesgo de sistemas de IA según el AI Act (Reglamento UE 2024/1689)

# Fase 1 · /reasoning. Adaptador GRPO final sobre Qwen3-0.6B (el modelo base sale de su
# adapter_config.json). Temperatura 0 = decodificación greedy, igual que rlm/evaluate.py.
ARCA_RLM_ADAPTER=rlm/weights/final_rlm_lora
ARCA_RLM_VERIFIER=aiact
ARCA_RLM_TEMPERATURE=0

# Fase 2 · /tools. Modelo, forma de presentar las herramientas (native = plantilla de Qwen con
# tools=, slides = prompt de las diapositivas), razonamiento y política de confirmación.
# Quién genera: local = ARCA_TOOLS_MODEL en esta GPU; openai = el servidor vLLM de LLM_BASE_URL
# (mismas variables LLM_* que la fase 3, ver más abajo). Con openai no se carga el modelo local.
ARCA_TOOLS_BACKEND=local
ARCA_TOOLS_MODEL=Qwen/Qwen3-4B
ARCA_TOOLS_PROMPT=native
ARCA_TOOLS_THINKING=0
ARCA_TOOLS_AUTO_CONFIRM=1
# Carpeta donde write_assessment_report deja los PDF
ARCA_REPORTS_DIR=reports/assessments

# Fase 3 · /rag. Troceado y λ elegidos con el conjunto dorado (rag/README.md): troceado
# recursivo de 1000 caracteres con el título del documento delante, híbrido 0,7·denso + 0,3·BM25.
ARCA_RAG_CHUNKING=recursive-1000+title
ARCA_RAG_LAMBDA=0.7
ARCA_RAG_MODEL=Qwen/Qwen3-4B
ARCA_RAG_THINKING=0
# Quién genera la respuesta de /rag: local = ARCA_RAG_MODEL en esta GPU; openai = un servidor
# con API compatible con OpenAI (el vLLM de la universidad). Con openai no se carga el modelo
# local. LLM_BASE_URL, LLM_API_KEY, LLM_MODEL y LLM_TIMEOUT los comparten /rag y /tools.
# LLM_MODEL vacío = el primero que anuncie el servidor en /v1/models.
LLM_BACKEND=local
LLM_BASE_URL=http://0.0.0.0:8001/v1
LLM_API_KEY=tu-clave-aqui
LLM_MODEL=
LLM_TIMEOUT=120
# Reranker (Qwen3-Reranker-0.6B) sobre 30 candidatos y umbral de «No lo sé» sobre su mejor
# puntuación, calibrado con rag/gold/calibration.jsonl (uv run python -m rag.calibrate).
ARCA_RAG_RERANK=1
ARCA_RAG_RERANK_POOL=30
ARCA_RAG_MIN_SCORE=0.9932

# Fase 4 · /agent. Cerebros: base = modelo base del adaptador de la fase 1 sin razonamiento,
# rlm = ese modelo + ARCA_RLM_ADAPTER, thinking = el modelo de abajo con razonamiento nativo.
ARCA_THINKING_MODEL=Qwen/Qwen3-1.7B
ARCA_AGENT_BASE_THINKING=0
ARCA_AGENT_RLM_THINKING=1
# Presupuesto de la memoria en tokens (el prompt de sistema ya ocupa ~4800)
ARCA_AGENT_TOKEN_BUDGET=9000
# write_assessment_report: task = solo si la tarea pide un informe; always; never
ARCA_AGENT_CONFIRM=task
# Semilla del muestreo de los cerebros con razonamiento
ARCA_AGENT_SEED=0
# Descomenta para fijar el mismo timeout (segundos) a todas las herramientas
# ARCA_AGENT_TOOL_TIMEOUT=10
